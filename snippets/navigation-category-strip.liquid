{%- comment -%}
  Desktop full-width department strip rendered below the header's main row.
  Distinct from navigation-desktop.liquid's hover mega-menu: this is a flat,
  bordered row of top-level links only, matching the reference design's single
  strip of departments/utility links. Items are entirely merchant-configured
  via the header section's menu setting — nothing here is hardcoded.

  Convention: a menu item titled with a trailing " · soon" (or " - soon" / "
  . soon", in case a merchant typed a plain hyphen/period instead of the
  middot — Phase 6, Stage 2) renders as an inert, muted label instead of a
  link. Detection is case-insensitive: the downcased title is matched to find
  the split point, then that same character count is sliced from the
  ORIGINAL-cased title, so the visible clean title keeps whatever casing the
  merchant actually typed.

  Params:
    menu - a linklist object (section.settings.main_menu)
{%- endcomment -%}
{%- if menu != blank -%}
  <nav class="category-strip" aria-label="{{ 'header.main_navigation' | t }}">
    <ul class="category-strip__list" role="list">
      {%- for link in menu.links -%}
        {%- liquid
          assign title_down = link.title | downcase | strip
          assign strip_title = link.title | strip
          assign is_soon = false

          if title_down contains ' · soon'
            assign soon_prefix = title_down | split: ' · soon' | first
            assign is_soon = true
          elsif title_down contains ' - soon'
            assign soon_prefix = title_down | split: ' - soon' | first
            assign is_soon = true
          elsif title_down contains ' . soon'
            assign soon_prefix = title_down | split: ' . soon' | first
            assign is_soon = true
          endif

          if is_soon
            assign soon_prefix_len = soon_prefix | size
            assign strip_title = strip_title | slice: 0, soon_prefix_len
          endif
        -%}
        <li class="category-strip__item">
          {%- if is_soon -%}
            <span class="category-strip__link category-strip__link--soon">{{ strip_title }} · {{ 'general.soon' | t }}</span>
          {%- else -%}
            <a href="{{ link.url }}" class="category-strip__link{% if link.active %} is-active{% endif %}">{{ strip_title }}</a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </nav>
{%- endif -%}
