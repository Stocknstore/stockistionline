{%- comment -%}
  Cart drawer. Phase 1 shipped the empty state only; Stage 4A added the
  real populated state (native, no-JS-required {% form 'cart' %} markup);
  Stage 4B layers AJAX on top in assets/theme.js — every control here still
  works exactly as it did in Stage 4A with JavaScript off.

  This whole snippet is what sections/cart-drawer.liquid renders, which is
  in turn what Shopify wraps as #shopify-section-cart-drawer — the exact
  node assets/theme.js replaces wholesale on every add/change/remove
  response (never [data-cart-drawer] itself, which would nest a second
  wrapper inside the first on every refresh). data-cart-item-count on the
  root carries the authoritative cart.item_count for JS to sync the
  header/mobile badges from — deliberately not named data-cart-count,
  which is the existing, different attribute on those badge elements
  themselves. data-label-cart-updated/-item-removed carry pre-translated
  strings for JS's accessible live-region announcements after a change, so
  nothing is hardcoded in JS.

  Only one of the populated/empty branches ever renders — data-cart-items/
  -empty/-footer are kept as hooks a full page reload (no-JS path) and the
  Stage 4B refresh (AJAX path) both rely on already being there.

  Rendered on every page via sections/cart-drawer.liquid, so ids/data-cart-
  line-key are prefixed/scoped to stay unique alongside sections/main-cart.
  liquid's own copies of the same cart.items on the /cart page itself —
  data-cart-line-key itself is just the raw item.key on both, since
  assets/theme.js always looks it up within one section's DOM at a time.
{%- endcomment -%}
<div
  class="cart-drawer"
  data-cart-drawer
  data-cart-item-count="{{ cart.item_count }}"
  data-label-cart-updated="{{ 'cart.updated' | t }}"
  data-label-item-removed="{{ 'cart.item_removed' | t }}"
  aria-hidden="true"
>
  <div class="cart-drawer__overlay" data-cart-close></div>

  <div class="cart-drawer__panel" role="dialog" aria-modal="true" aria-label="{{ 'header.cart' | t }}">
    <button type="button" class="icon-close-btn icon-close-btn--circle cart-drawer__close" data-cart-close aria-label="{{ 'general.close' | t }}">
      {% render 'icon', icon: 'close' %}
    </button>

    {%- if cart.item_count > 0 -%}
      {%- form 'cart', cart, id: 'CartDrawerForm', class: 'cart-drawer__form' -%}
        <div class="cart-drawer__error" data-cart-error data-label-generic-error="{{ 'cart.generic_error' | t }}" role="alert" aria-live="assertive" hidden></div>

        <div class="cart-drawer__items" data-cart-items>
          {%- for item in cart.items -%}
            <div class="cart-drawer__item">
              <a href="{{ item.url }}" class="cart-drawer__item-image-link" aria-hidden="true" tabindex="-1">
                {%- if item.image -%}
                  <img
                    class="cart-drawer__item-image"
                    src="{{ item.image | image_url: width: 160 }}"
                    alt=""
                    width="{{ item.image.width }}"
                    height="{{ item.image.height }}"
                    loading="lazy"
                  >
                {%- else -%}
                  <span class="cart-drawer__item-placeholder"></span>
                {%- endif -%}
              </a>
              <div class="cart-drawer__item-details">
                <a href="{{ item.url }}" class="cart-drawer__item-title">{{ item.product.title }}</a>
                {%- if item.variant.title != 'Default Title' -%}
                  <span class="cart-drawer__item-variant">{{ item.variant.title }}</span>
                {%- endif -%}
                <span class="cart-drawer__item-price">{{ item.final_line_price | money }}</span>
                <div class="cart-drawer__item-row">
                  <label class="visually-hidden" for="CartDrawerQuantity-{{ item.key }}">{{ 'cart.quantity_label' | t }}</label>
                  <input
                    type="number"
                    id="CartDrawerQuantity-{{ item.key }}"
                    name="updates[{{ item.key }}]"
                    value="{{ item.quantity }}"
                    min="0"
                    class="cart-drawer__item-quantity-input"
                    data-cart-line-key="{{ item.key }}"
                    data-cart-control="quantity"
                  >
                  <a
                    href="{{ item.url_to_remove }}"
                    class="cart-drawer__item-remove"
                    data-cart-line-key="{{ item.key }}"
                    data-cart-control="remove"
                  >{{ 'cart.remove' | t }}</a>
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>

        <div class="cart-drawer__footer" data-cart-footer>
          <div class="cart-drawer__subtotal">
            <span>{{ 'header.subtotal' | t }}</span>
            <span data-cart-subtotal>{{ cart.total_price | money }}</span>
          </div>
          <button type="submit" name="update" class="button button--outline button--full">{{ 'cart.update_cart' | t }}</button>
          <a href="{{ routes.cart_url }}" class="button button--outline button--full">{{ 'header.view_cart' | t }}</a>
          <button type="submit" name="checkout" class="button button--primary button--full">{{ 'header.checkout' | t }}</button>
        </div>
      {%- endform -%}
    {%- else -%}
      <div class="cart-drawer__empty" data-cart-empty>
        <h2 class="cart-drawer__empty-title">{{ 'header.cart_empty' | t }}</h2>

        <a href="{{ routes.all_products_collection_url }}" class="button button--primary">
          {{ 'header.continue_shopping' | t }}
        </a>

        {%- unless shop.customer_accounts_enabled == false -%}
          <p class="cart-drawer__account-prompt">
            {{ 'header.have_account' | t }}
            <a href="{{ routes.account_login_url }}" class="cart-drawer__login-link">
              {{ 'header.login_link' | t }}
            </a>
            {{ 'header.login_faster_checkout' | t }}
          </p>
        {%- endunless -%}
      </div>
    {%- endif -%}
  </div>
</div>
