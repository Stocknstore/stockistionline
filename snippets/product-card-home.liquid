{%- comment -%}
  Snippet: product-card-home
  Scoped product card for the homepage "Just arrived" section only
  (sections/home-just-arrived.liquid). Renders real Shopify product data —
  image, vendor, title, price/compare-at price, and available size-option
  values — plus an optional stock-status badge. Kept separate from any future
  collection/product-page card component so those can evolve independently.

  Params:
    product    - required, a Shopify product object
    variant    - 'grid' (desktop) or 'rail' (mobile horizontal scroller)
    show_badge - true to render the stock-status badge chip. Grid cards show
                 it; rail cards sit under an already-labeled "New today" /
                 "Last pair" header instead, matching the prototype, where a
                 repeated per-card badge would be redundant there.
    badge_key  - 'new_today' or 'last_pair', pre-computed once by the caller
                 (sections/home-just-arrived.liquid) so the badge logic
                 (metafield first, tag fallback) lives in a single place.

  Phase 7, Stage 4E: the mobile ('rail') card shows the available sizes as
  a compact "min–max" range instead of every available value — the desktop
  ('grid') card is untouched and keeps the original full dot-separated
  list, since this fix is scoped to the mobile carousel only. The Size
  option's position (1/2/3) is found dynamically above, exactly as
  before — never assumed to be option1. If every available value is purely numeric
  (checked character-by-character, so "41.5" half sizes count as numeric
  too), the range uses a real numeric min/max, not a string/lexicographic
  one (otherwise "10" would sort before "9"), while still DISPLAYING each
  bound using its original string (so "41", not a coerced "41.0"). If any
  available value isn't numeric, the range instead uses the first and last
  available value in the order Shopify's own option configuration already
  defines (product.options_with_values[].values), never alphabetical.
{%- endcomment -%}
{%- liquid
  assign card_variant = variant | default: 'grid'
  assign show_badge = show_badge | default: false

  assign size_position = 0
  assign size_option_values = blank
  for option in product.options_with_values
    if option.name == 'Size'
      assign size_position = forloop.index
      assign size_option_values = option.values
    endif
  endfor
  assign available_size_values = ''
  if size_position > 0
    for v in product.variants
      if v.available
        case size_position
          when 1
            assign available_size_values = available_size_values | append: v.option1 | append: '||'
          when 2
            assign available_size_values = available_size_values | append: v.option2 | append: '||'
          when 3
            assign available_size_values = available_size_values | append: v.option3 | append: '||'
        endcase
      endif
    endfor
  endif
  assign available_sizes = available_size_values | split: '||' | uniq

  assign size_display = ''
  if available_sizes.size == 1
    assign size_display = available_sizes.first
  elsif available_sizes.size > 1
    assign all_numeric = true
    for size_value in available_sizes
      assign size_chars = size_value | split: ''
      if size_chars.size == 0
        assign all_numeric = false
      endif
      for ch in size_chars
        unless ch == '0' or ch == '1' or ch == '2' or ch == '3' or ch == '4' or ch == '5' or ch == '6' or ch == '7' or ch == '8' or ch == '9' or ch == '.'
          assign all_numeric = false
        endunless
      endfor
    endfor

    if all_numeric
      assign is_first_size = true
      for size_value in available_sizes
        assign size_num = size_value | times: 1.0
        if is_first_size
          assign min_size_num = size_num
          assign max_size_num = size_num
          assign min_size_display = size_value
          assign max_size_display = size_value
          assign is_first_size = false
        else
          if size_num < min_size_num
            assign min_size_num = size_num
            assign min_size_display = size_value
          endif
          if size_num > max_size_num
            assign max_size_num = size_num
            assign max_size_display = size_value
          endif
        endif
      endfor
      assign size_display = min_size_display | append: '–' | append: max_size_display
    else
      assign ordered_available = ''
      for val in size_option_values
        if available_sizes contains val
          assign ordered_available = ordered_available | append: val | append: '||'
        endif
      endfor
      assign ordered_available_list = ordered_available | split: '||'
      if ordered_available_list.size == 0
        assign ordered_available_list = available_sizes
      endif
      assign size_display = ordered_available_list.first | append: '–' | append: ordered_available_list.last
    endif
  endif
-%}
<div class="product-card-home product-card-home--{{ card_variant }}">
<a href="{{ product.url }}" class="product-card-home__link">
  <div class="product-card-home__image-wrap">
    {%- if show_badge and badge_key != blank -%}
      <span class="product-card-home__badge product-card-home__badge--{{ badge_key }}">
        {%- if badge_key == 'new_today' -%}
          {{- 'home_just_arrived.badge_new_today' | t -}}
        {%- else -%}
          {{- 'home_just_arrived.badge_last_pair' | t -}}
        {%- endif -%}
      </span>
    {%- endif -%}
    {%- if product.featured_image != blank -%}
      {%- assign widths = "200,300,450,600,800" | split: ',' -%}
      <img
        class="product-card-home__image"
        src="{{ product.featured_image | image_url: width: 600 }}"
        srcset="
          {%- for w in widths -%}
            {{ product.featured_image | image_url: width: w }} {{ w }}w{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        "
        sizes="{% if card_variant == 'rail' %}30vw{% else %}(min-width: 1280px) 25vw, (min-width: 768px) 33vw, 50vw{% endif %}"
        alt="{{ product.featured_image.alt | default: product.title | strip_newlines }}"
        width="{{ product.featured_image.width }}"
        height="{{ product.featured_image.height }}"
        loading="lazy"
      >
    {%- else -%}
      <div class="product-card-home__placeholder">
        <span class="product-card-home__placeholder-label">{{ product.title }}</span>
      </div>
    {%- endif -%}
  </div>
  <div class="product-card-home__meta">
    {%- if product.vendor != blank -%}
      <span class="product-card-home__vendor" title="{{ product.vendor | escape }}">{{ product.vendor }}</span>
    {%- endif -%}
    <span class="product-card-home__title">{{ product.title }}</span>
    <span class="product-card-home__price-row">
      <span class="product-card-home__price">{{ product.price | money }}</span>
      {%- if product.compare_at_price > product.price -%}
        <span class="product-card-home__compare-at">{{ product.compare_at_price | money }}</span>
      {%- endif -%}
    </span>
    {%- if card_variant == 'rail' -%}
      {%- if size_display != blank -%}
        <span class="product-card-home__sizes">{{ size_display }}</span>
      {%- endif -%}
    {%- elsif available_sizes.size > 0 -%}
      <span class="product-card-home__sizes">{{ available_sizes | join: ' · ' }}</span>
    {%- endif -%}
  </div>
</a>
{%- render 'wishlist-button', product: product -%}
</div>
