{%- comment -%}
  Sticky mobile-only bottom bar (Home / Shop / Search / Cart). Rendered once,
  globally, in layout/theme.liquid — like the mobile menu/search/account/cart
  drawers, it isn't tied to a particular section's settings. Its four
  destinations are fixed utility actions rather than merchant content, so
  unlike the header's department strip it takes no menu param: Search and
  Cart reuse the same existing drawer triggers as the header
  (data-search-toggle / data-cart-toggle), and Home/Shop are stable Shopify
  routes rather than section-configured links.
{%- endcomment -%}
<nav class="mobile-bottom-bar" aria-label="{{ 'header.main_navigation' | t }}">
  <a href="{{ routes.root_url }}" class="mobile-bottom-bar__item">
    {% render 'icon', icon: 'home', size: 18 %}
    <span>{{ 'general.home' | t }}</span>
  </a>
  <a href="{{ routes.all_products_collection_url }}" class="mobile-bottom-bar__item">
    {% render 'icon', icon: 'grid', size: 18 %}
    <span>{{ 'general.shop' | t }}</span>
  </a>
  <button type="button" class="mobile-bottom-bar__item" data-search-toggle>
    {% render 'icon', icon: 'search', size: 18 %}
    <span>{{ 'header.search' | t }}</span>
  </button>
  <button type="button" class="mobile-bottom-bar__item mobile-bottom-bar__item--active" data-cart-toggle>
    {% render 'icon', icon: 'bag', size: 18 %}
    <span>{{ 'header.cart' | t }} {{ cart.item_count }}</span>
  </button>
</nav>
