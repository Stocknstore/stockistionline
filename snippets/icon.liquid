{%- comment -%}
  Global icon system. One consistent stroke-based SVG set.
  Usage: {% render 'icon', icon: 'cart', size: 20 %}
  Params:
    icon   - required, one of the names below
    size   - optional, px, default 20
{%- endcomment -%}
{%- liquid
  assign icon_size = size | default: 20
-%}
<svg
  class="icon icon--{{ icon }}"
  width="{{ icon_size }}"
  height="{{ icon_size }}"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {%- case icon -%}
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="7"></circle>
      <path d="M21 21l-4.35-4.35"></path>
    {%- when 'user' -%}
      <circle cx="12" cy="8" r="4"></circle>
      <path d="M4 21c0-4.4 3.6-7.5 8-7.5s8 3.1 8 7.5"></path>
    {%- when 'bag' -%}
      <path d="M6 8h12l-1 13H7z"></path>
      <path d="M9 8V6a3 3 0 0 1 6 0v2"></path>
    {%- when 'heart' -%}
      <path d="M12 20.5s-7.5-4.6-9.8-9.2C.6 7.8 2.3 4.5 5.6 4c2-.3 3.9.6 5 2.2C11.7 4.6 13.6 3.7 15.6 4c3.3.5 5 3.8 3.4 7.3C16.7 15.9 12 20.5 12 20.5z"></path>
    {%- when 'globe' -%}
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M3 12h18"></path>
      <path d="M12 3c2.5 2.5 3.8 5.7 3.8 9s-1.3 6.5-3.8 9c-2.5-2.5-3.8-5.7-3.8-9S9.5 5.5 12 3z"></path>
    {%- when 'menu' -%}
      <path d="M3 6h18"></path>
      <path d="M3 12h18"></path>
      <path d="M3 18h18"></path>
    {%- when 'close' -%}
      <path d="M5 5l14 14"></path>
      <path d="M19 5L5 19"></path>
    {%- when 'chevron-down' -%}
      <path d="M6 9l6 6 6-6"></path>
    {%- when 'chevron-up' -%}
      <path d="M6 15l6-6 6 6"></path>
    {%- when 'chevron-left' -%}
      <path d="M15 6l-6 6 6 6"></path>
    {%- when 'chevron-right' -%}
      <path d="M9 6l6 6-6 6"></path>
    {%- when 'arrow-right' -%}
      <path d="M4 12h15"></path>
      <path d="M13 6l6 6-6 6"></path>
    {%- when 'arrow-left' -%}
      <path d="M20 12H5"></path>
      <path d="M11 6l-6 6 6 6"></path>
    {%- when 'plus' -%}
      <path d="M12 5v14"></path>
      <path d="M5 12h14"></path>
    {%- when 'minus' -%}
      <path d="M5 12h14"></path>
  {%- endcase -%}
</svg>
