{%- comment -%}
  Snippet: product-gallery
  Phase 4, Stage 1. Renders product.media generically — never assumes a
  fixed count. Base markup is a single horizontal scroll-snap row that is
  fully viewable with zero JavaScript at every breakpoint (mobile keeps this
  row permanently, per spec). assets/theme.js progressively enhances the
  desktop/tablet (min-width:768px) presentation into one large active slide
  plus a thumbnail strip by toggling the is-enhanced/is-active classes below
  — it never sets the hidden attribute, since an unconditional [hidden]
  would also hide slides on mobile; the display:none for inactive slides is
  instead scoped inside the matching @media range in theme.css (section 33),
  matching the pattern already established for .hidden-mobile/.hidden-
  desktop elsewhere in this theme.

  Params:
    product - required, a Shopify product object
{%- endcomment -%}
{%- liquid
  assign media_list = product.media
  assign media_count = media_list.size
-%}
<div class="product-gallery" data-product-gallery>
  {%- if media_count == 0 -%}
    <div class="product-gallery__slide product-gallery__slide--placeholder">
      <div class="product-gallery__placeholder">
        <span class="product-gallery__placeholder-label">{{ product.title | strip_newlines }}</span>
      </div>
    </div>
  {%- else -%}
    <div class="product-gallery__main">
      {%- for media in media_list -%}
        {%- liquid
          assign loading = 'lazy'
          assign fetchpriority = 'auto'
          if forloop.first
            assign loading = 'eager'
            assign fetchpriority = 'high'
          endif
          assign media_alt = media.alt | default: product.title | strip_newlines
        -%}
        <div
          class="product-gallery__slide{% if forloop.first %} is-active{% endif %}"
          data-gallery-slide
          data-media-id="{{ media.id }}"
        >
          {%- if media.preview_image -%}
            {%- assign widths = '400,600,800,1000,1200' | split: ',' -%}
            <img
              class="product-gallery__image"
              src="{{ media.preview_image | image_url: width: 1000 }}"
              srcset="{%- for w in widths -%}{{ media.preview_image | image_url: width: w }} {{ w }}w{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}"
              sizes="(min-width: 1280px) 50vw, 100vw"
              alt="{{ media_alt }}"
              width="{{ media.preview_image.width }}"
              height="{{ media.preview_image.height }}"
              loading="{{ loading }}"
              fetchpriority="{{ fetchpriority }}"
            >
          {%- else -%}
            <div class="product-gallery__placeholder">
              <span class="product-gallery__placeholder-label">{{ media_alt }}</span>
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if media_count > 1 -%}
      <div class="product-gallery__thumbs hidden-mobile" role="group" aria-label="{{ 'product.gallery_thumbnails' | t }}">
        {%- for media in media_list -%}
          <button
            type="button"
            class="product-gallery__thumb{% if forloop.first %} is-active{% endif %}"
            data-gallery-thumb
            data-media-id="{{ media.id }}"
            aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
            aria-label="{{ 'product.gallery_view_image' | t: index: forloop.index, count: media_count }}"
          >
            {%- if media.preview_image -%}
              <img
                class="product-gallery__thumb-image"
                src="{{ media.preview_image | image_url: width: 160 }}"
                alt=""
                width="80"
                height="80"
                loading="lazy"
              >
            {%- else -%}
              <span class="product-gallery__thumb-placeholder" aria-hidden="true"></span>
            {%- endif -%}
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  {%- endif -%}
</div>
