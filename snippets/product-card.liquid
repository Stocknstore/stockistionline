{%- comment -%}
  Snippet: product-card
  Phase 3, Stage 1 (revised Stage 4). General-purpose product card for
  collection/search pages (not used by the homepage — snippets/
  product-card-home.liquid stays separate and unchanged so the two can
  evolve independently). Renders real Shopify product data: image, vendor,
  title, price/compare-at price, and available size-option values, plus the
  same badge priority already established for the homepage card.

  Rendered once per product regardless of grid/list view — the caller
  (sections/collection-grid.liquid) renders each product exactly once, and
  the grid/list presentation is applied purely via CSS scoped to the
  ancestor .collection-grid[data-view] attribute (assets/theme.css section
  28), not by rendering this snippet twice with different markup. This
  keeps analytics, accessibility and (future) quick-add wiring tied to a
  single real DOM node per product.

  Params:
    product     - required, a Shopify product object
    above_fold  - true to load the image eagerly (first row); omit/false
                  for lazy loading everywhere else

  Phase 7, Stage 4F: at <=749px, vendor/title truncate and the sizes row
  switches from the full dot-separated list to a compact "min–max" range
  (same dynamic option-position + numeric-aware logic as snippets/
  product-card-home.liquid's rail card) — but since this one Liquid render
  can't know the viewport, BOTH the full list and the compact range are
  rendered as separate .product-card__sizes--full/--range spans, and CSS
  (assets/theme.css) shows exactly one of the two at a time via the same
  749px breakpoint. This snippet is shared by sections/collection-grid.liquid
  (PLP) and sections/product-recommendations.liquid ("You might also
  like"), so the mobile behavior applies to both — there's only one card
  component, not a per-page fork of it.
{%- endcomment -%}
{%- liquid
  assign loading = 'lazy'
  assign fetchpriority = 'auto'
  if above_fold
    assign loading = 'eager'
    assign fetchpriority = 'high'
  endif

  assign badge_key = ''
  for tag in product.tags
    assign tag_down = tag | downcase
    if tag_down == 'new today'
      assign badge_key = 'new_today'
    endif
    if tag_down == 'last pair'
      assign badge_key = 'last_pair'
    endif
  endfor
  assign stock_badge_mf = product.metafields.custom.stock_badge
  if stock_badge_mf != blank
    assign mf_down = stock_badge_mf | downcase | strip
    if mf_down == 'new_today' or mf_down == 'last_pair'
      assign badge_key = mf_down
    endif
  endif
  if badge_key == 'new_today'
    assign badge_label = 'product_card.badge_new_today' | t
  elsif badge_key == 'last_pair'
    assign badge_label = 'product_card.badge_last_pair' | t
  endif

  assign size_position = 0
  assign size_option_values = blank
  for option in product.options_with_values
    if option.name == 'Size'
      assign size_position = forloop.index
      assign size_option_values = option.values
    endif
  endfor
  assign available_size_values = ''
  if size_position > 0
    for v in product.variants
      if v.available
        case size_position
          when 1
            assign available_size_values = available_size_values | append: v.option1 | append: '||'
          when 2
            assign available_size_values = available_size_values | append: v.option2 | append: '||'
          when 3
            assign available_size_values = available_size_values | append: v.option3 | append: '||'
        endcase
      endif
    endfor
  endif
  assign available_sizes = available_size_values | split: '||' | uniq

  assign size_display = ''
  if available_sizes.size == 1
    assign size_display = available_sizes.first
  elsif available_sizes.size > 1
    assign all_numeric = true
    for size_value in available_sizes
      assign size_chars = size_value | split: ''
      if size_chars.size == 0
        assign all_numeric = false
      endif
      for ch in size_chars
        unless ch == '0' or ch == '1' or ch == '2' or ch == '3' or ch == '4' or ch == '5' or ch == '6' or ch == '7' or ch == '8' or ch == '9' or ch == '.'
          assign all_numeric = false
        endunless
      endfor
    endfor

    if all_numeric
      assign is_first_size = true
      for size_value in available_sizes
        assign size_num = size_value | times: 1.0
        if is_first_size
          assign min_size_num = size_num
          assign max_size_num = size_num
          assign min_size_display = size_value
          assign max_size_display = size_value
          assign is_first_size = false
        else
          if size_num < min_size_num
            assign min_size_num = size_num
            assign min_size_display = size_value
          endif
          if size_num > max_size_num
            assign max_size_num = size_num
            assign max_size_display = size_value
          endif
        endif
      endfor
      assign size_display = min_size_display | append: '–' | append: max_size_display
    else
      assign ordered_available = ''
      for val in size_option_values
        if available_sizes contains val
          assign ordered_available = ordered_available | append: val | append: '||'
        endif
      endfor
      assign ordered_available_list = ordered_available | split: '||'
      if ordered_available_list.size == 0
        assign ordered_available_list = available_sizes
      endif
      assign size_display = ordered_available_list.first | append: '–' | append: ordered_available_list.last
    endif
  endif
-%}
<div class="product-card">
<a
  href="{{ product.url }}"
  class="product-card__link"
  aria-label="{{ product.title | strip_newlines }}{% if badge_label != blank %}, {{ badge_label }}{% endif %}"
>
  <div class="product-card__image-wrap">
    {%- if badge_label != blank -%}
      <span class="product-card__badge product-card__badge--{{ badge_key }}">{{ badge_label }}</span>
    {%- endif -%}
    {%- if product.featured_image != blank -%}
      {%- assign widths = "200,300,450,600,800" | split: ',' -%}
      <img
        class="product-card__image"
        src="{{ product.featured_image | image_url: width: 600 }}"
        srcset="
          {%- for w in widths -%}
            {{ product.featured_image | image_url: width: w }} {{ w }}w{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        "
        sizes="(min-width: 1280px) 25vw, (min-width: 768px) 33vw, 50vw"
        alt="{{ product.featured_image.alt | default: product.title | strip_newlines }}"
        width="{{ product.featured_image.width }}"
        height="{{ product.featured_image.height }}"
        loading="{{ loading }}"
        fetchpriority="{{ fetchpriority }}"
      >
    {%- else -%}
      <div class="product-card__placeholder">
        <span class="product-card__placeholder-label">{{ product.title | strip_newlines }}</span>
      </div>
    {%- endif -%}
  </div>
  <div class="product-card__meta">
    {%- if product.vendor != blank -%}
      <span class="product-card__vendor">{{ product.vendor }}</span>
    {%- endif -%}
    <span class="product-card__title">{{ product.title }}</span>
    <span class="product-card__price-row">
      <span class="product-card__price">{{ product.price | money }}</span>
      {%- if product.compare_at_price > product.price -%}
        <span class="product-card__compare-at">{{ product.compare_at_price | money }}</span>
      {%- endif -%}
    </span>
    {%- if available_sizes.size > 0 -%}
      <span class="product-card__sizes product-card__sizes--full">{{ available_sizes | join: ' · ' }}</span>
    {%- endif -%}
    {%- if size_display != blank -%}
      <span class="product-card__sizes product-card__sizes--range">{{ size_display }}</span>
    {%- endif -%}
  </div>
</a>
{%- render 'wishlist-button', product: product -%}
</div>
