{%- comment -%}
  Section: Home hero
  Phase 2, Step 1. Reconstructs the hero block from prototype-reference's
  renderLanding() (prototype-reference/templates.js ~L63-83): a 4-column grid
  (photo / text panel / stock counter / featured brands) that collapses to
  2 columns on tablet and a compact 2-column mobile layout, matching the
  prototype's --heroCols/--heroRowSpan/--textSpan/--brandsSpan breakpoint
  behavior exactly (prototype-reference/styles.css L16-165).

  Phase 6, Stage 3B: optional collection-backed mode for the stock counter
  and featured-brands panel. When settings.data_source is "collection" and
  a real collection is selected, the counter number/note and the brand
  names are computed from that collection's real products/vendors instead
  of merchant-typed text — never a fabricated number. Manual mode (typed
  counter_number/counter_note + featured_brand blocks) remains available
  as a fallback and is what a fresh section instance defaults to.

  Phase 6, Stage 4C: the single hero_image setting above is upgraded to an
  optional multi-image slideshow via repeatable "hero_slide" blocks (max
  3), rendered/driven by [data-hero-slideshow] in theme.js. If no
  hero_slide block has a desktop image configured, rendering falls back
  to hero_image exactly as before — this stage never removes or changes
  that setting or its markup. With exactly one valid slide, the same
  slide markup renders but with no autoplay/controls at all (see
  valid_slide_count below).
{%- endcomment -%}
{%- liquid
  assign hero_image = section.settings.hero_image
  assign data_source = section.settings.data_source | default: 'manual'
  assign source_collection = section.settings.source_collection
  assign auto_vendor_list = section.settings.auto_vendor_list

  assign use_collection_data = false
  if data_source == 'collection' and source_collection != blank
    assign use_collection_data = true
  endif

  assign display_counter_number = section.settings.counter_number
  assign display_counter_note = section.settings.counter_note
  assign vendor_names = blank

  if use_collection_data
    assign product_count = source_collection.products_count
    assign display_counter_number = product_count

    # Exact delimiter-based dedup, not substring `contains` — a plain
    # substring check would wrongly treat "Grand Polo" as already-seen
    # once "Polo" (or vice versa) was added, since one name can be a
    # literal substring of the other. Wrapping every accumulated name in
    # "||" and checking for the full "||Name||" token guarantees only an
    # exact match short-circuits the append.
    assign vendor_scan = '||'
    for product in source_collection.products
      assign vendor_name = product.vendor | strip
      if vendor_name != blank
        assign vendor_token = '||' | append: vendor_name | append: '||'
        unless vendor_scan contains vendor_token
          assign vendor_scan = vendor_scan | append: vendor_name | append: '||'
        endunless
      endif
    endfor

    assign vendor_names_raw = vendor_scan | split: '||'
    assign vendor_scan_clean = ''
    for v in vendor_names_raw
      if v != blank
        assign vendor_scan_clean = vendor_scan_clean | append: v | append: '||'
      endif
    endfor
    assign vendor_names = vendor_scan_clean | split: '||' | uniq
    assign vendor_count = vendor_names.size

    if product_count > 0
      assign display_counter_note = 'home_hero.counter_note_collection' | t: count: vendor_count
    else
      assign display_counter_note = 'home_hero.counter_note_empty' | t
    endif
  endif

  assign valid_slide_count = 0
  for block in section.blocks
    if block.type == 'hero_slide' and block.settings.desktop_image != blank
      assign valid_slide_count = valid_slide_count | plus: 1
    endif
  endfor

  assign autoplay_enabled = section.settings.autoplay
  assign autoplay_interval_seconds = section.settings.autoplay_interval | default: 5
  assign autoplay_interval_ms = autoplay_interval_seconds | times: 1000
  assign show_controls = section.settings.show_controls
-%}
<section class="home-hero" {{ section.shopify_attributes }}>
  <div class="home-hero__photo">
    {%- if valid_slide_count > 0 -%}
      <div
        class="home-hero__slideshow"
        data-hero-slideshow
        data-slide-count="{{ valid_slide_count }}"
        data-autoplay="{{ autoplay_enabled }}"
        data-autoplay-interval="{{ autoplay_interval_ms }}"
      >
        <div class="home-hero__slides" role="region" aria-roledescription="carousel" aria-label="{{ 'home_hero.slideshow_label' | t }}">
          {%- assign slide_position = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'hero_slide' and block.settings.desktop_image != blank -%}
              {%- assign is_first_slide = false -%}
              {%- if slide_position == 0 -%}
                {%- assign is_first_slide = true -%}
              {%- endif -%}
              {%- assign slide_number = slide_position | plus: 1 -%}
              {%- assign desktop_img = block.settings.desktop_image -%}
              {%- assign mobile_img = block.settings.mobile_image -%}
              {%- assign slide_alt = block.settings.alt_text | default: desktop_img.alt | default: section.settings.heading | strip_newlines -%}
              {%- assign widths = "375,550,750,1100,1500,1780" | split: ',' -%}
              {%- assign mobile_widths = "375,550,750,1100" | split: ',' -%}
              <div
                class="home-hero__slide{% if is_first_slide %} is-active{% endif %}"
                data-hero-slide
                data-slide-index="{{ slide_position }}"
                data-slide-announcement="{{ 'home_hero.slide_position' | t: index: slide_number, total: valid_slide_count }}"
                role="group"
                aria-roledescription="{{ 'home_hero.slide_role' | t }}"
                aria-label="{{ 'home_hero.slide_position' | t: index: slide_number, total: valid_slide_count }}"
                {%- unless is_first_slide %} aria-hidden="true"{%- endunless %}
                {{ block.shopify_attributes }}
              >
                <picture>
                  {%- if mobile_img != blank -%}
                    <source
                      media="(max-width: 767px)"
                      srcset="
                        {%- for w in mobile_widths -%}
                          {{ mobile_img | image_url: width: w }} {{ w }}w{%- unless forloop.last -%},{%- endunless -%}
                        {%- endfor -%}
                      "
                      sizes="100vw"
                    >
                  {%- endif -%}
                  <img
                    class="home-hero__photo-img"
                    src="{{ desktop_img | image_url: width: 1500 }}"
                    srcset="
                      {%- for w in widths -%}
                        {{ desktop_img | image_url: width: w }} {{ w }}w{%- unless forloop.last -%},{%- endunless -%}
                      {%- endfor -%}
                    "
                    sizes="(min-width: 1280px) 50vw, 100vw"
                    alt="{{ slide_alt }}"
                    width="{{ desktop_img.width }}"
                    height="{{ desktop_img.height }}"
                    {%- if is_first_slide %}
                    loading="eager"
                    fetchpriority="high"
                    {%- else %}
                    loading="lazy"
                    {%- endif %}
                  >
                </picture>
              </div>
              {%- assign slide_position = slide_position | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if valid_slide_count > 1 -%}
          <div class="visually-hidden" role="status" aria-live="polite" data-hero-slide-announcer></div>

          {%- if show_controls -%}
            <button type="button" class="home-hero__slide-arrow home-hero__slide-arrow--prev" data-hero-prev aria-label="{{ 'home_hero.previous_slide' | t }}">
              {%- render 'icon', icon: 'chevron-left', size: 18 -%}
            </button>
            <button type="button" class="home-hero__slide-arrow home-hero__slide-arrow--next" data-hero-next aria-label="{{ 'home_hero.next_slide' | t }}">
              {%- render 'icon', icon: 'chevron-right', size: 18 -%}
            </button>
          {%- endif -%}

          <div class="home-hero__slideshow-bottom">
            {%- if show_controls -%}
              <div class="home-hero__slide-dots" data-hero-dots role="tablist" aria-label="{{ 'home_hero.slide_picker_label' | t }}">
                {%- for i in (1..valid_slide_count) -%}
                  <button
                    type="button"
                    class="home-hero__slide-dot{% if forloop.first %} is-active{% endif %}"
                    data-hero-dot
                    data-slide-index="{{ forloop.index0 }}"
                    role="tab"
                    aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                    aria-label="{{ 'home_hero.go_to_slide' | t: index: forloop.index }}"
                  ></button>
                {%- endfor -%}
              </div>
            {%- endif -%}

            {%- if autoplay_enabled -%}
              <button
                type="button"
                class="home-hero__slide-playpause"
                data-hero-playpause
                aria-pressed="false"
                aria-label="{{ 'home_hero.pause_slideshow' | t }}"
                data-label-pause="{{ 'home_hero.pause_slideshow' | t }}"
                data-label-play="{{ 'home_hero.play_slideshow' | t }}"
              >
                <span data-hero-playpause-icon class="home-hero__slide-playpause-icon is-playing" aria-hidden="true"></span>
              </button>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- elsif hero_image != blank -%}
      {%- assign widths = "375,550,750,1100,1500,1780" | split: ',' -%}
      <img
        class="home-hero__photo-img"
        src="{{ hero_image | image_url: width: 1500 }}"
        srcset="
          {%- for w in widths -%}
            {{ hero_image | image_url: width: w }} {{ w }}w{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        "
        sizes="(min-width: 1280px) 50vw, 100vw"
        alt="{{ hero_image.alt | default: section.settings.heading | strip_newlines }}"
        width="{{ hero_image.width }}"
        height="{{ hero_image.height }}"
        loading="eager"
        fetchpriority="high"
      >
    {%- else -%}
      <div class="home-hero__placeholder">
        <span class="home-hero__placeholder-label">{{ 'home_hero.placeholder' | t }}</span>
      </div>
    {%- endif -%}
  </div>

  <div class="home-hero__content">
    <div class="home-hero__content-top">
      {%- if section.settings.eyebrow != blank -%}
        <span class="home-hero__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="home-hero__heading">{{ section.settings.heading | newline_to_br }}</h1>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <p class="home-hero__body">{{ section.settings.body }}</p>
      {%- endif -%}
    </div>
    <div class="home-hero__buttons">
      {%- if section.settings.primary_button_label != blank -%}
        <a href="{{ section.settings.primary_button_link | default: '#' }}" class="home-hero__button home-hero__button--primary">
          {{ section.settings.primary_button_label }}
        </a>
      {%- endif -%}
      {%- if section.settings.secondary_button_label != blank -%}
        <a href="{{ section.settings.secondary_button_link | default: '#' }}" class="home-hero__button home-hero__button--secondary">
          {{ section.settings.secondary_button_label }}
        </a>
      {%- endif -%}
    </div>
  </div>

  <div class="home-hero__counter">
    {%- if section.settings.counter_label != blank -%}
      <span class="home-hero__counter-label">{{ section.settings.counter_label }}</span>
    {%- endif -%}
    <div class="home-hero__counter-body">
      {%- if display_counter_number != blank -%}
        <div class="home-hero__counter-number">{{ display_counter_number }}</div>
      {%- endif -%}
      <div class="home-hero__counter-note">
        {{ display_counter_note }}{%- if section.settings.counter_updated_text != blank -%}<span class="home-hero__counter-updated"><br>{{ section.settings.counter_updated_text }}</span>{%- endif -%}
      </div>
    </div>
  </div>

  <div class="home-hero__brands">
    {%- if section.settings.brands_heading != blank -%}
      <span class="home-hero__brands-eyebrow">{{ section.settings.brands_heading }}</span>
    {%- endif -%}
    <div class="home-hero__brands-list">
      {%- if use_collection_data and auto_vendor_list -%}
        {%- for vendor_name in vendor_names limit: 4 -%}
          <span class="home-hero__brand-name">{{ vendor_name }}</span>
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'featured_brand' -%}
            <span class="home-hero__brand-name" {{ block.shopify_attributes }}>{{ block.settings.name }}</span>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
      {%- if section.settings.brands_more_text != blank -%}
        <a href="{{ section.settings.brands_more_link | default: '#' }}" class="home-hero__brands-more">{{ section.settings.brands_more_text }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home hero",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Photo"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image",
      "info": "Used only when no \"Hero slide\" blocks below have an image set."
    },
    {
      "type": "header",
      "content": "Slideshow"
    },
    {
      "type": "paragraph",
      "content": "Add up to three \"Hero slide\" blocks below to show an automatic slideshow instead of the single hero image above. Each slide needs at least a desktop image; the mobile image and alt text are optional."
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_interval",
      "label": "Autoplay interval (seconds)",
      "min": 4,
      "max": 10,
      "step": 1,
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "show_controls",
      "label": "Show arrows and dots",
      "default": true
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "The warehouse, open to everyone"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "info": "A new line controls where the heading breaks.",
      "default": "New stock.\nTrusted brands."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body text",
      "default": "Twenty-six years of wholesale and retail, now online. See what landed today."
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "primary_button_label",
      "label": "Primary button label",
      "default": "Discover the shoes"
    },
    {
      "type": "url",
      "id": "primary_button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary button label",
      "default": "View new stock"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary button link"
    },
    {
      "type": "header",
      "content": "Stock counter data source"
    },
    {
      "type": "paragraph",
      "content": "Manual mode uses the typed values below. Collection mode computes the number, note and \"This week's brands\" panel from a real collection's actual products/vendors — never a typed-in figure."
    },
    {
      "type": "select",
      "id": "data_source",
      "label": "Data source",
      "options": [
        { "value": "manual", "label": "Manual (typed values below)" },
        { "value": "collection", "label": "Selected collection (real, automatic)" }
      ],
      "default": "manual"
    },
    {
      "type": "collection",
      "id": "source_collection",
      "label": "Source collection",
      "info": "Used only when Data source above is \"Selected collection\"."
    },
    {
      "type": "checkbox",
      "id": "auto_vendor_list",
      "label": "Automatically list the collection's real vendors",
      "info": "Replaces the featured-brand blocks below with the source collection's actual product vendors (up to 4 shown). Only applies in collection mode.",
      "default": true
    },
    {
      "type": "header",
      "content": "Stock counter (manual mode)"
    },
    {
      "type": "text",
      "id": "counter_label",
      "label": "Label",
      "default": "Stock counter"
    },
    {
      "type": "text",
      "id": "counter_number",
      "label": "Number"
    },
    {
      "type": "text",
      "id": "counter_note",
      "label": "Note"
    },
    {
      "type": "text",
      "id": "counter_updated_text",
      "label": "Updated-at text",
      "info": "Optional. Hidden on mobile."
    },
    {
      "type": "header",
      "content": "Featured brands panel"
    },
    {
      "type": "text",
      "id": "brands_heading",
      "label": "Heading",
      "default": "This week's brands"
    },
    {
      "type": "text",
      "id": "brands_more_text",
      "label": "\"More brands\" link label",
      "default": "Browse all brands"
    },
    {
      "type": "url",
      "id": "brands_more_link",
      "label": "\"More brands\" link"
    }
  ],
  "blocks": [
    {
      "type": "hero_slide",
      "name": "Hero slide",
      "limit": 3,
      "settings": [
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "Desktop image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image",
          "info": "Optional. Falls back to the desktop image on small screens if left blank."
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt text override",
          "info": "Optional. Falls back to the image's own alt text, then the heading."
        }
      ]
    },
    {
      "type": "featured_brand",
      "name": "Featured brand",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Brand name",
          "default": "Brand name"
        }
      ]
    }
  ],
  "max_blocks": 7
}
{% endschema %}
