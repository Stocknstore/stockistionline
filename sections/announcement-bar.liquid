{%- comment -%}
  Section: Announcement Bar
  Compact promotional strip: rotating messages via blocks (left) plus a short
  static utility strip of merchant-editable text items (right) — e.g.
  shipping/returns copy — matching the reference design's two-part bar.

  Phase 7, Stage 9: on mobile this becomes a single static line — no
  rotation, no utility strip — reusing whichever existing utility_text item
  the merchant already configured (mobile_message_position, 1-indexed into
  the same pipe-separated list the desktop utility strip already renders;
  no separate/duplicated text setting). The rotating blocks and the full
  utility list are left completely unchanged in markup; only CSS (section
  6 of theme.css) swaps what's visible per breakpoint. The rotating track
  is display:none on mobile, which also removes its links from the tab
  order — never a visually-hidden-but-still-focusable state.
{%- endcomment -%}
{%- if section.settings.enable and section.blocks.size > 0 -%}
  {%- liquid
    assign utility_items = section.settings.utility_text | split: '|'
    assign mobile_position = section.settings.mobile_message_position | default: 1
    assign mobile_index = mobile_position | minus: 1
    assign mobile_message = ''
    if mobile_index >= 0
      assign mobile_message = utility_items[mobile_index] | strip
    endif
    if mobile_message == blank and utility_items.first != blank
      assign mobile_message = utility_items.first | strip
    endif
  -%}
  <div
    class="announcement-bar"
    {{ section.shopify_attributes }}
    style="
      --announcement-bg: {{ section.settings.color_background }};
      --announcement-text: {{ section.settings.color_text }};
    "
    data-announcement-bar
    {% if section.blocks.size > 1 %}data-autoplay="{{ section.settings.autoplay_seconds }}"{% endif %}
  >
    <div class="announcement-bar__inner container container--full">
      <div class="announcement-bar__track" data-announcement-track>
        {%- for block in section.blocks -%}
          <div
            class="announcement-bar__item{% if forloop.first %} is-active{% endif %}"
            data-announcement-item
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="announcement-bar__link">
                <span>{{ block.settings.text }}</span>
                {%- if block.settings.link_label != blank -%}
                  <span class="announcement-bar__cta">{{ block.settings.link_label }}</span>
                {%- endif -%}
              </a>
            {%- else -%}
              <span>{{ block.settings.text }}</span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      {%- if utility_items.size > 0 -%}
        <ul class="announcement-bar__utility" role="list">
          {%- for item in utility_items -%}
            {%- assign trimmed_item = item | strip -%}
            {%- if trimmed_item != blank -%}
              <li>{{ trimmed_item }}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if mobile_message != blank -%}
        <p class="announcement-bar__mobile-message">{{ mobile_message }}</p>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable",
      "label": "Enable announcement bar",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_seconds",
      "label": "Rotate every (seconds)",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 5
    },
    {
      "type": "header",
      "content": "Utility strip"
    },
    {
      "type": "text",
      "id": "utility_text",
      "label": "Utility text items",
      "info": "Short items shown on the right, separated by a vertical bar ( | ). Leave blank to hide.",
      "default": "Free shipping over €79|30-day returns"
    },
    {
      "type": "number",
      "id": "mobile_message_position",
      "label": "Mobile message (utility item #)",
      "default": 1,
      "info": "On mobile, only this one utility text item shows (counting from 1, left to right above). Everything else — the rotating messages and the rest of the utility strip — is hidden. Defaults to the first item."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "Background",
      "default": "#141414"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Text",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "End of season sale up to 50% off."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Shop Now"
        }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        {
          "type": "message",
          "settings": {
            "text": "End of season sale up to 50% off.",
            "link_label": "Shop Now"
          }
        },
        {
          "type": "message",
          "settings": {
            "text": "Extra 10% off on first order.",
            "link_label": "Shop Now"
          }
        }
      ]
    }
  ]
}
{% endschema %}
