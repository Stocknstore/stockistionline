{%- comment -%}
  Section: Announcement Bar
  Compact promotional strip. Supports multiple rotating messages via blocks.
{%- endcomment -%}
{%- if section.settings.enable and section.blocks.size > 0 -%}
  <div
    class="announcement-bar"
    {{ section.shopify_attributes }}
    style="
      --announcement-bg: {{ section.settings.color_background }};
      --announcement-text: {{ section.settings.color_text }};
    "
    data-announcement-bar
    {% if section.blocks.size > 1 %}data-autoplay="{{ section.settings.autoplay_seconds }}"{% endif %}
  >
    <div class="announcement-bar__track" data-announcement-track>
      {%- for block in section.blocks -%}
        <div
          class="announcement-bar__item{% if forloop.first %} is-active{% endif %}"
          data-announcement-item
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="announcement-bar__link">
              <span>{{ block.settings.text }}</span>
              {%- if block.settings.link_label != blank -%}
                <span class="announcement-bar__cta">{{ block.settings.link_label }}</span>
              {%- endif -%}
            </a>
          {%- else -%}
            <span>{{ block.settings.text }}</span>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable",
      "label": "Enable announcement bar",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_seconds",
      "label": "Rotate every (seconds)",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 5
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "Background",
      "default": "#141414"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Text",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "End of season sale up to 50% off."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Shop Now"
        }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        {
          "type": "message",
          "settings": {
            "text": "End of season sale up to 50% off.",
            "link_label": "Shop Now"
          }
        },
        {
          "type": "message",
          "settings": {
            "text": "Extra 10% off on first order.",
            "link_label": "Shop Now"
          }
        }
      ]
    }
  ]
}
{% endschema %}
