{%- comment -%}
  Section: Announcement Bar
  Compact promotional strip: rotating messages via blocks (left) plus a short
  static utility strip of merchant-editable text items (right) — e.g.
  shipping/returns copy — matching the reference design's two-part bar.
{%- endcomment -%}
{%- if section.settings.enable and section.blocks.size > 0 -%}
  {%- assign utility_items = section.settings.utility_text | split: '|' -%}
  <div
    class="announcement-bar"
    {{ section.shopify_attributes }}
    style="
      --announcement-bg: {{ section.settings.color_background }};
      --announcement-text: {{ section.settings.color_text }};
    "
    data-announcement-bar
    {% if section.blocks.size > 1 %}data-autoplay="{{ section.settings.autoplay_seconds }}"{% endif %}
  >
    <div class="announcement-bar__inner container container--full">
      <div class="announcement-bar__track" data-announcement-track>
        {%- for block in section.blocks -%}
          <div
            class="announcement-bar__item{% if forloop.first %} is-active{% endif %}"
            data-announcement-item
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="announcement-bar__link">
                <span>{{ block.settings.text }}</span>
                {%- if block.settings.link_label != blank -%}
                  <span class="announcement-bar__cta">{{ block.settings.link_label }}</span>
                {%- endif -%}
              </a>
            {%- else -%}
              <span>{{ block.settings.text }}</span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      {%- if utility_items.size > 0 -%}
        <ul class="announcement-bar__utility" role="list">
          {%- for item in utility_items -%}
            {%- assign trimmed_item = item | strip -%}
            {%- if trimmed_item != blank -%}
              <li>{{ trimmed_item }}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable",
      "label": "Enable announcement bar",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_seconds",
      "label": "Rotate every (seconds)",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 5
    },
    {
      "type": "header",
      "content": "Utility strip"
    },
    {
      "type": "text",
      "id": "utility_text",
      "label": "Utility text items",
      "info": "Short items shown on the right, separated by a vertical bar ( | ). Leave blank to hide.",
      "default": "Free shipping over €79|30-day returns"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "Background",
      "default": "#141414"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Text",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "End of season sale up to 50% off."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Shop Now"
        }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        {
          "type": "message",
          "settings": {
            "text": "End of season sale up to 50% off.",
            "link_label": "Shop Now"
          }
        },
        {
          "type": "message",
          "settings": {
            "text": "Extra 10% off on first order.",
            "link_label": "Shop Now"
          }
        }
      ]
    }
  ]
}
{% endschema %}
