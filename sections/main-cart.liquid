{%- comment -%}
  Section: Main cart
  Phase 4, Stage 4A (native, no-JS-required cart page) + Stage 4B (AJAX
  quantity/removal on top). Same real cart.items rendering as snippets/
  cart-drawer.liquid (image/placeholder, title+link, variant title when
  not "Default Title", line price, an editable quantity via updates[
  {{ item.key }}], and an item.url_to_remove link), subtotal, Update cart,
  Checkout (name="checkout") and Continue shopping. Every control still
  works as a real submit/real link with JS off; no custom checkout is
  built, "checkout" hands off to Shopify's own hosted checkout.

  Unlike the static cart-drawer section, this is a dynamic JSON-template
  section, so its actual section.id at runtime isn't just "main-cart" —
  it's exposed via data-section-id on the root so assets/theme.js can
  request/replace #shopify-section-{that id} by its real id rather than a
  hardcoded guess (the drawer's own #shopify-section-cart-drawer is
  requested/replaced separately, in parallel, by the same AJAX call).

  This section and the global drawer both render cart.items independently
  on this same page — ids here are prefixed CartPage- to stay unique
  alongside the drawer's CartDrawer- prefixed copies of the same item
  keys; data-cart-line-key itself is just the raw item.key on both, since
  assets/theme.js always looks it up within one section's DOM at a time.
{%- endcomment -%}
<section class="cart-page container container--medium" data-section-id="{{ section.id }}" {{ section.shopify_attributes }}>
  <h1 class="cart-page__title">{{ 'cart.title' | t }}</h1>

  {%- if cart.item_count == 0 -%}
    <div class="cart-page__empty" data-cart-page-empty>
      <p class="cart-page__empty-text">{{ 'header.cart_empty' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="button button--primary">
        {{ 'header.continue_shopping' | t }}
      </a>
    </div>
  {%- else -%}
    {%- form 'cart', cart, id: 'CartPageForm', class: 'cart-page__form' -%}
      <div class="cart-page__error" data-cart-error data-label-generic-error="{{ 'cart.generic_error' | t }}" role="alert" aria-live="assertive" hidden></div>

      <div class="cart-page__items">
        {%- for item in cart.items -%}
          <div class="cart-page__item">
            <a href="{{ item.url }}" class="cart-page__item-image-link" aria-hidden="true" tabindex="-1">
              {%- if item.image -%}
                <img
                  class="cart-page__item-image"
                  src="{{ item.image | image_url: width: 240 }}"
                  alt=""
                  width="{{ item.image.width }}"
                  height="{{ item.image.height }}"
                  loading="lazy"
                >
              {%- else -%}
                <span class="cart-page__item-placeholder"></span>
              {%- endif -%}
            </a>
            <div class="cart-page__item-details">
              <a href="{{ item.url }}" class="cart-page__item-title">{{ item.product.title }}</a>
              {%- if item.variant.title != 'Default Title' -%}
                <span class="cart-page__item-variant">{{ item.variant.title }}</span>
              {%- endif -%}
              <a
                href="{{ item.url_to_remove }}"
                class="cart-page__item-remove"
                data-cart-line-key="{{ item.key }}"
                data-cart-control="remove"
              >{{ 'cart.remove' | t }}</a>
            </div>
            <div class="cart-page__item-quantity">
              <label class="visually-hidden" for="CartPageQuantity-{{ item.key }}">{{ 'cart.quantity_label' | t }}</label>
              <input
                type="number"
                id="CartPageQuantity-{{ item.key }}"
                name="updates[{{ item.key }}]"
                value="{{ item.quantity }}"
                min="0"
                class="cart-page__item-quantity-input"
                data-cart-line-key="{{ item.key }}"
                data-cart-control="quantity"
              >
            </div>
            <span class="cart-page__item-price">{{ item.final_line_price | money }}</span>
          </div>
        {%- endfor -%}
      </div>

      <div class="cart-page__footer">
        <div class="cart-page__subtotal">
          <span>{{ 'header.subtotal' | t }}</span>
          <span>{{ cart.total_price | money }}</span>
        </div>
        <div class="cart-page__actions">
          <button type="submit" name="update" class="button button--outline">{{ 'cart.update_cart' | t }}</button>
          <button type="submit" name="checkout" class="button button--primary">{{ 'header.checkout' | t }}</button>
        </div>
        <a href="{{ routes.all_products_collection_url }}" class="cart-page__continue">{{ 'header.continue_shopping' | t }}</a>
      </div>
    {%- endform -%}
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Main cart",
  "settings": []
}
{% endschema %}
