{%- comment -%}
  Section: Home brand wall
  Phase 2, Step 3. Reconstructs the "Brand wall" grid from prototype-reference's
  renderLanding() (prototype-reference/templates.js ~L108-119), matching the
  prototype's --brandCols breakpoint behavior (prototype-reference/styles.css
  L16-165): 6 columns desktop, 4 tablet, 2 mobile. Each block may show a logo
  (object-fit: contain, never stretched) or fall back to the brand name typeset
  the same way the prototype renders its text-only wall.

  Phase 6, Stage 3B: automatic mode iterates the real, store-wide
  `shop.vendors` list — a newly uploaded product's vendor appears here with
  no theme edit required. `brand` blocks become optional overrides, matched
  to a real vendor by exact normalized (trimmed, case-insensitive) name —
  a vendor with no matching block just renders as a plain text name, never
  a placeholder. Manual mode (the blocks alone, unchanged) remains
  available as a fallback.
{%- endcomment -%}
{%- liquid
  assign source_mode = section.settings.source_mode | default: 'manual'
  assign vendor_list = shop.vendors
  assign vendor_count = vendor_list.size
  assign display_eyebrow = section.settings.eyebrow
  if source_mode == 'automatic'
    assign display_eyebrow = 'home_brand_wall.eyebrow_auto' | t: count: vendor_count
  endif
-%}
<section class="home-brand-wall" {{ section.shopify_attributes }}>
  <div class="home-brand-wall__header">
    <div>
      {%- if display_eyebrow != blank -%}
        <span class="home-brand-wall__eyebrow">{{ display_eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="home-brand-wall__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>
    {%- if section.settings.az_label != blank -%}
      <a href="{{ section.settings.az_link | default: '#' }}" class="home-brand-wall__az">{{ section.settings.az_label }}</a>
    {%- endif -%}
  </div>

  <div class="home-brand-wall__grid">
    {%- if source_mode == 'automatic' -%}
      {%- for vendor in vendor_list -%}
        {%- liquid
          assign vendor_down = vendor | strip | downcase
          assign override = blank
          for block in section.blocks
            if block.type == 'brand'
              assign block_name_down = block.settings.name | strip | downcase
              if block_name_down == vendor_down
                assign override = block
              endif
            endif
          endfor

          assign logo = blank
          assign note = blank
          assign vendor_param = vendor | url_param_escape
          assign tile_link = routes.all_products_collection_url | append: '?filter.v.vendor=' | append: vendor_param
          if override != blank
            assign logo = override.settings.logo
            if override.settings.note != blank
              assign note = override.settings.note
            endif
            if override.settings.link != blank
              assign tile_link = override.settings.link
            endif
          endif
          assign is_new = false
          if note == 'new today'
            assign is_new = true
          endif
        -%}
        <a href="{{ tile_link }}" class="home-brand-wall__tile">
          <div class="home-brand-wall__mark">
            {%- if logo != blank -%}
              {%- assign widths = "150,225,300,400" | split: ',' -%}
              <img
                class="home-brand-wall__logo"
                src="{{ logo | image_url: width: 300 }}"
                srcset="
                  {%- for w in widths -%}
                    {{ logo | image_url: width: w }} {{ w }}w{%- unless forloop.last -%},{%- endunless -%}
                  {%- endfor -%}
                "
                sizes="150px"
                alt="{{ logo.alt | default: vendor | strip_newlines }}"
                width="{{ logo.width }}"
                height="{{ logo.height }}"
                loading="lazy"
              >
            {%- else -%}
              <span class="home-brand-wall__name">{{ vendor }}</span>
            {%- endif -%}
          </div>
          {%- if note != blank -%}
            <span class="home-brand-wall__note{% if is_new %} home-brand-wall__note--new{% endif %}">{{ note }}</span>
          {%- endif -%}
        </a>
      {%- endfor -%}
    {%- else -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'brand' -%}
          {%- assign logo = block.settings.logo -%}
          {%- assign is_new = false -%}
          {%- if block.settings.note == 'new today' -%}{%- assign is_new = true -%}{%- endif -%}
          <a href="{{ block.settings.link | default: '#' }}" class="home-brand-wall__tile" {{ block.shopify_attributes }}>
            <div class="home-brand-wall__mark">
              {%- if logo != blank -%}
                {%- assign widths = "150,225,300,400" | split: ',' -%}
                <img
                  class="home-brand-wall__logo"
                  src="{{ logo | image_url: width: 300 }}"
                  srcset="
                    {%- for w in widths -%}
                      {{ logo | image_url: width: w }} {{ w }}w{%- unless forloop.last -%},{%- endunless -%}
                    {%- endfor -%}
                  "
                  sizes="150px"
                  alt="{{ logo.alt | default: block.settings.name | strip_newlines }}"
                  width="{{ logo.width }}"
                  height="{{ logo.height }}"
                  loading="lazy"
                >
              {%- else -%}
                <span class="home-brand-wall__name">{{ block.settings.name }}</span>
              {%- endif -%}
            </div>
            {%- if block.settings.note != blank -%}
              <span class="home-brand-wall__note{% if is_new %} home-brand-wall__note--new{% endif %}">{{ block.settings.note }}</span>
            {%- endif -%}
          </a>
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Home brand wall",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Brand source"
    },
    {
      "type": "select",
      "id": "source_mode",
      "label": "Brand source",
      "options": [
        { "value": "manual", "label": "Manual (brand blocks below)" },
        { "value": "automatic", "label": "Automatic — real Shopify vendors" }
      ],
      "default": "manual",
      "info": "Automatic mode lists every vendor with at least one product in the store and needs no manual updates as new brands are uploaded."
    },
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text (manual mode)",
      "info": "Ignored in automatic mode, which shows a real, always-accurate vendor count instead."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Brand wall"
    },
    {
      "type": "text",
      "id": "az_label",
      "label": "\"A–Z\" link label",
      "default": "A–Z"
    },
    {
      "type": "url",
      "id": "az_link",
      "label": "\"A–Z\" link"
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo",
          "info": "Optional. Falls back to the brand name if left blank."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Brand name",
          "default": "Brand name"
        },
        {
          "type": "text",
          "id": "note",
          "label": "Note",
          "info": "For example \"new today\" or \"32 styles\". \"new today\" is highlighted automatically.",
          "default": "0 styles"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 48
}
{% endschema %}
