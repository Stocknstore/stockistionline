{%- comment -%}
  Section: Home coming soon
  Phase 2, Step 7. Reconstructs "Coming soon — More to discover" from
  prototype-reference's renderLanding() (prototype-reference/templates.js
  ~L166-174), matching the prototype's --soonCols/--padX breakpoint behavior
  (prototype-reference/styles.css L16-165: 4 columns desktop, 2 columns
  tablet and mobile).

  The prototype's tiles are text-only (date + category name). This section
  extends that with an optional image per tile so real category photography
  can be added later — but the image sits in its own bounded area above the
  text, never behind/under it, so category/date text is never at risk of
  being illegible over a busy photo (image_fit is merchant-configurable:
  "contain" for transparent PNG/item graphics, "cover" for full photography).

  Phase 6, Stage 4B: the "Notify me" action only renders when its link is
  actually set — no `| default: '#'` fallback. Each tile stays visible
  regardless of whether it has a real link: with one, it's a real <a>;
  without one, it renders as a plain, non-interactive <div> with the exact
  same classes/layout — never a dead `#` link, and deliberately no
  role="link"/tabindex added to fake interactivity that doesn't exist yet.
{%- endcomment -%}
{%- assign image_fit = section.settings.image_fit | default: 'cover' -%}
<section class="home-coming-soon home-coming-soon--fit-{{ image_fit }}" {{ section.shopify_attributes }}>
  <div class="home-coming-soon__header">
    <div>
      {%- if section.settings.eyebrow != blank -%}
        <span class="home-coming-soon__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="home-coming-soon__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>
    {%- if section.settings.notify_label != blank and section.settings.notify_link != blank -%}
      <a href="{{ section.settings.notify_link }}" class="home-coming-soon__notify">{{ section.settings.notify_label }}</a>
    {%- endif -%}
  </div>

  <div class="home-coming-soon__grid">
    {%- for block in section.blocks -%}
      {%- if block.type == 'category_teaser' -%}
        {%- assign img = block.settings.image -%}
        {%- assign has_link = false -%}
        {%- if block.settings.link != blank -%}
          {%- assign has_link = true -%}
        {%- endif -%}
        {%- capture tile_content -%}
          <div class="home-coming-soon__tile-image">
            {%- if img != blank -%}
              {%- assign widths = "200,300,450,600" | split: ',' -%}
              <img
                class="home-coming-soon__tile-img"
                src="{{ img | image_url: width: 450 }}"
                srcset="
                  {%- for w in widths -%}
                    {{ img | image_url: width: w }} {{ w }}w{%- unless forloop.last -%},{%- endunless -%}
                  {%- endfor -%}
                "
                sizes="(min-width: 768px) 25vw, 50vw"
                alt="{{ block.settings.alt_text | default: img.alt | default: block.settings.title | strip_newlines }}"
                width="{{ img.width }}"
                height="{{ img.height }}"
                loading="lazy"
              >
            {%- else -%}
              <div class="home-coming-soon__placeholder">
                <span class="home-coming-soon__placeholder-label">{{ 'home_coming_soon.placeholder' | t }}</span>
              </div>
            {%- endif -%}
          </div>
          <div class="home-coming-soon__tile-content">
            {%- if block.settings.date != blank -%}
              <span class="home-coming-soon__tile-date">{{ block.settings.date }}</span>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <span class="home-coming-soon__tile-title">{{ block.settings.title }}</span>
            {%- endif -%}
          </div>
        {%- endcapture -%}
        {%- if has_link -%}
          <a href="{{ block.settings.link }}" class="home-coming-soon__tile" {{ block.shopify_attributes }}>{{ tile_content }}</a>
        {%- else -%}
          <div class="home-coming-soon__tile" {{ block.shopify_attributes }}>{{ tile_content }}</div>
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Home coming soon",
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Coming soon"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "More to discover"
    },
    {
      "type": "text",
      "id": "notify_label",
      "label": "\"Notify me\" link label",
      "default": "Notify me when it lands"
    },
    {
      "type": "url",
      "id": "notify_link",
      "label": "\"Notify me\" link"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image style",
      "info": "Contain works best for transparent PNG or item graphics. Cover works best for full background photography.",
      "options": [
        { "value": "cover", "label": "Cover (full background photo)" },
        { "value": "contain", "label": "Contain (transparent PNG / item graphic)" }
      ],
      "default": "cover"
    }
  ],
  "blocks": [
    {
      "type": "category_teaser",
      "name": "Category teaser",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Optional."
        },
        {
          "type": "text",
          "id": "date",
          "label": "Date / season text",
          "default": "Coming soon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category title",
          "default": "Category"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Optional."
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt text override",
          "info": "Optional. Falls back to the image's own alt text, then the category title."
        }
      ]
    }
  ],
  "max_blocks": 8
}
{% endschema %}
