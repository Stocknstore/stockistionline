{%- comment -%}
  Section: Collection grid
  Phase 3, Stage 3. Standard product-listing template for ordinary
  collections (Women, Men, Kids, etc — not the Footwear category landing,
  which uses templates/collection.category.json + sections/collection-hero.
  liquid instead). Matches the core title/count/grid presentation from
  prototype-reference's renderPlp() (prototype-reference/templates.js
  ~L249-252, L302-303): breadcrumb, H1, "N styles in stock", and a
  --prodCols-equivalent grid (4 desktop / 3 tablet / 2 mobile). Filters,
  sorting, view toggles and the mobile filter drawer are deliberately not
  included yet — later Phase 3 stages layer those onto this same section.

  Cards are rendered through snippets/product-card.liquid (card_view: grid),
  never the homepage-only product-card-home.liquid. Only the first grid row
  (the first 4 products — the widest breakpoint's column count, matching
  the standard "eager-load the first row, lazy everything else" pattern) is
  marked above_fold so it loads eagerly; the rest lazy-load.
{%- endcomment -%}
{%- liquid
  assign per_page = section.settings.products_per_page | default: 16
-%}
<section class="collection-grid" {{ section.shopify_attributes }}>
  <div class="collection-grid__breadcrumb">
    <a href="{{ routes.root_url }}">{{ 'collection_grid.breadcrumb_home' | t }}</a>
    <span aria-hidden="true">/</span>
    <span class="collection-grid__breadcrumb-current">{{ collection.title }}</span>
  </div>

  <div class="collection-grid__header">
    <div>
      <h1 class="collection-grid__title">{{ collection.title }}</h1>
      <div class="collection-grid__count">
        {{- 'collection_grid.product_count' | t: count: collection.all_products_count -}}
      </div>
    </div>
  </div>

  {%- if collection.description != blank -%}
    <div class="collection-grid__description">{{ collection.description }}</div>
  {%- endif -%}

  {%- if collection.products.size == 0 -%}
    <div class="collection-grid__empty">
      <p class="collection-grid__empty-title">{{ 'collection_grid.empty_title' | t }}</p>
      <p class="collection-grid__empty-body">{{ 'collection_grid.empty_body' | t }}</p>
    </div>
  {%- else -%}
    {%- paginate collection.products by per_page -%}
      <div class="collection-grid__products">
        {%- for product in collection.products -%}
          {%- assign above_fold = false -%}
          {%- if forloop.index <= 4 -%}
            {%- assign above_fold = true -%}
          {%- endif -%}
          {%- render 'product-card', product: product, card_view: 'grid', above_fold: above_fold -%}
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="collection-grid__pagination" aria-label="{{ 'collection_grid.pagination_label' | t }}">
          <ul class="collection-grid__pagination-list" role="list">
            <li>
              {%- if paginate.previous -%}
                <a href="{{ paginate.previous.url }}" class="collection-grid__page-link collection-grid__page-link--prev" aria-label="{{ 'collection_grid.previous' | t }}">{{ 'collection_grid.previous' | t }}</a>
              {%- else -%}
                <span class="collection-grid__page-link collection-grid__page-link--prev collection-grid__page-link--disabled" aria-disabled="true">{{ 'collection_grid.previous' | t }}</span>
              {%- endif -%}
            </li>
            {%- for part in paginate.parts -%}
              <li>
                {%- if part.is_link -%}
                  <a href="{{ part.url }}" class="collection-grid__page-link" aria-label="{{ 'collection_grid.go_to_page' | t: number: part.title }}">{{ part.title }}</a>
                {%- elsif part.title == paginate.current_page -%}
                  <span class="collection-grid__page-link collection-grid__page-link--current" aria-current="page" aria-label="{{ 'collection_grid.current_page' | t: number: part.title }}">{{ part.title }}</span>
                {%- else -%}
                  <span class="collection-grid__page-link collection-grid__page-link--ellipsis" aria-hidden="true">{{ part.title }}</span>
                {%- endif -%}
              </li>
            {%- endfor -%}
            <li>
              {%- if paginate.next -%}
                <a href="{{ paginate.next.url }}" class="collection-grid__page-link collection-grid__page-link--next" aria-label="{{ 'collection_grid.next' | t }}">{{ 'collection_grid.next' | t }}</a>
              {%- else -%}
                <span class="collection-grid__page-link collection-grid__page-link--next collection-grid__page-link--disabled" aria-disabled="true">{{ 'collection_grid.next' | t }}</span>
              {%- endif -%}
            </li>
          </ul>
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Collection grid",
  "settings": [
    {
      "type": "header",
      "content": "Grid"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 4,
      "max": 48,
      "step": 4,
      "default": 16
    }
  ]
}
{% endschema %}
