{%- comment -%}
  Section: Home start shopping
  Phase 2, Step 2. Reconstructs the "Shop by department" / Footwear block and
  its "Arriving soon" side panel from prototype-reference's renderLanding()
  (prototype-reference/templates.js ~L85-106), matching the prototype's
  --startCols/--blockPad/--blockH2/--deptCols/--deptDisplay/--deptCardW
  breakpoint behavior (prototype-reference/styles.css L16-165). The Arriving
  Soon crossfade is pure CSS (@keyframes arriveCycle): each block gets an
  animation-delay computed at render time so any number of blocks distributes
  evenly across one 10s loop, exactly generalizing the prototype's fixed
  2-item "10s" / "10s 5s" stagger — no JavaScript involved.
{%- endcomment -%}
{%- assign arriving_blocks = section.blocks | where: 'type', 'arriving_soon_item' -%}
{%- assign arriving_count = arriving_blocks.size -%}
<section class="home-start-shopping" {{ section.shopify_attributes }}>
  <div class="home-start-shopping__inner">
    <div class="home-start-shopping__panel home-start-shopping__panel--footwear">
      <div class="home-start-shopping__panel-header">
        <div>
          {%- if section.settings.heading != blank -%}
            <h2 class="home-start-shopping__heading">{{ section.settings.heading }}</h2>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <div class="home-start-shopping__subheading">{{ section.settings.subheading }}</div>
          {%- endif -%}
        </div>
        {%- if section.settings.browse_all_label != blank -%}
          <a href="{{ section.settings.browse_all_link | default: '#' }}" class="home-start-shopping__browse-all">{{ section.settings.browse_all_label }}</a>
        {%- endif -%}
      </div>

      <div class="home-start-shopping__departments">
        {%- for block in section.blocks -%}
          {%- if block.type == 'department' -%}
            {%- assign dept_image = block.settings.image -%}
            <a href="{{ block.settings.link | default: '#' }}" class="home-start-shopping__dept-card" {{ block.shopify_attributes }}>
              <div class="home-start-shopping__dept-image">
                {%- if dept_image != blank -%}
                  {%- assign widths = "300,450,600,800" | split: ',' -%}
                  <img
                    class="home-start-shopping__dept-img"
                    src="{{ dept_image | image_url: width: 600 }}"
                    srcset="
                      {%- for w in widths -%}
                        {{ dept_image | image_url: width: w }} {{ w }}w{%- unless forloop.last -%},{%- endunless -%}
                      {%- endfor -%}
                    "
                    sizes="(min-width: 768px) 25vw, 88vw"
                    alt="{{ dept_image.alt | default: block.settings.title | strip_newlines }}"
                    width="{{ dept_image.width }}"
                    height="{{ dept_image.height }}"
                    loading="lazy"
                  >
                {%- else -%}
                  <div class="home-start-shopping__placeholder">
                    <span class="home-start-shopping__placeholder-label">{{ 'home_start_shopping.placeholder' | t }}</span>
                  </div>
                {%- endif -%}
              </div>
              <div class="home-start-shopping__dept-meta">
                <span class="home-start-shopping__dept-title">{{ block.settings.title }}</span>
                <span class="home-start-shopping__dept-count">{{ block.settings.style_count }}</span>
              </div>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <div class="home-start-shopping__panel home-start-shopping__panel--arriving">
      {%- if section.settings.arriving_soon_heading != blank -%}
        <div class="home-start-shopping__arriving-header">
          <span class="home-start-shopping__arriving-eyebrow">{{ section.settings.arriving_soon_heading }}</span>
        </div>
      {%- endif -%}

      <div class="home-start-shopping__arriving-stage">
        {%- for block in arriving_blocks -%}
          {%- assign arriving_image = block.settings.image -%}
          {%- assign delay = forloop.index0 | times: 10.0 | divided_by: arriving_count -%}
          <div class="home-start-shopping__arriving-tile" style="animation-delay: {{ delay }}s" {{ block.shopify_attributes }}>
            <div class="home-start-shopping__arriving-image">
              {%- if arriving_image != blank -%}
                {%- assign widths = "300,450,600,800" | split: ',' -%}
                <img
                  class="home-start-shopping__arriving-img"
                  src="{{ arriving_image | image_url: width: 600 }}"
                  srcset="
                    {%- for w in widths -%}
                      {{ arriving_image | image_url: width: w }} {{ w }}w{%- unless forloop.last -%},{%- endunless -%}
                    {%- endfor -%}
                  "
                  sizes="(min-width: 1280px) 25vw, 100vw"
                  alt="{{ arriving_image.alt | default: block.settings.title | strip_newlines }}"
                  width="{{ arriving_image.width }}"
                  height="{{ arriving_image.height }}"
                  loading="lazy"
                >
              {%- else -%}
                <div class="home-start-shopping__placeholder">
                  <span class="home-start-shopping__placeholder-label">{{ 'home_start_shopping.placeholder' | t }}</span>
                </div>
              {%- endif -%}
            </div>
            <div class="home-start-shopping__arriving-meta">
              <div class="home-start-shopping__arriving-title">{{ block.settings.title }}</div>
              <div class="home-start-shopping__arriving-text">{{ block.settings.arrival_text }}</div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home start shopping",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Footwear block"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Footwear"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Where would you like to start"
    },
    {
      "type": "text",
      "id": "browse_all_label",
      "label": "\"Browse all\" link label",
      "default": "Browse all footwear"
    },
    {
      "type": "url",
      "id": "browse_all_link",
      "label": "\"Browse all\" link"
    },
    {
      "type": "header",
      "content": "Arriving soon panel"
    },
    {
      "type": "text",
      "id": "arriving_soon_heading",
      "label": "Heading",
      "default": "Arriving soon"
    }
  ],
  "blocks": [
    {
      "type": "department",
      "name": "Department",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Department"
        },
        {
          "type": "text",
          "id": "style_count",
          "label": "Style count text",
          "default": "0 styles"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    },
    {
      "type": "arriving_soon_item",
      "name": "Arriving soon item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Coming soon"
        },
        {
          "type": "text",
          "id": "arrival_text",
          "label": "Arrival text",
          "default": "arriving soon"
        }
      ]
    }
  ],
  "max_blocks": 12
}
{% endschema %}
