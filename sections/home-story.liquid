{%- comment -%}
  Section: Home story
  Phase 2, Step 6. Reconstructs the "Since 2000 / 26 years" brand story
  section from prototype-reference's renderLanding() (prototype-reference/
  templates.js ~L156-164): a copy panel beside a 3-column stat grid with a
  wide photo spanning all 3 columns below it, matching the prototype's
  --storyCols/--storyPad/--storyNum/--statPad/--statNum/--statLabel
  breakpoint behavior (prototype-reference/styles.css L16-165). The wide
  photo's min-height (170px) and the stat grid's column count (3) are fixed,
  unresponsive values in the prototype too, so no custom properties are
  needed for those.
{%- endcomment -%}
{%- assign img = section.settings.image -%}
<section class="home-story" {{ section.shopify_attributes }}>
  <div class="home-story__copy">
    {%- if section.settings.eyebrow != blank -%}
      <span class="home-story__eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    {%- if section.settings.number != blank -%}
      <div class="home-story__number">{{ section.settings.number }}</div>
    {%- endif -%}
    {%- if section.settings.body != blank -%}
      <p class="home-story__body">{{ section.settings.body }}</p>
    {%- endif -%}
  </div>

  <div class="home-story__stats">
    {%- for block in section.blocks -%}
      {%- if block.type == 'stat' -%}
        <div class="home-story__stat" {{ block.shopify_attributes }}>
          {%- if block.settings.value != blank -%}
            <div class="home-story__stat-value">{{ block.settings.value }}</div>
          {%- endif -%}
          {%- if block.settings.label != blank -%}
            <div class="home-story__stat-label">{{ block.settings.label | newline_to_br }}</div>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}

    <div class="home-story__photo">
      {%- if img != blank -%}
        {%- assign widths = "400,600,900,1200,1600" | split: ',' -%}
        <img
          class="home-story__photo-img"
          src="{{ img | image_url: width: 1200 }}"
          srcset="
            {%- for w in widths -%}
              {{ img | image_url: width: w }} {{ w }}w{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          "
          sizes="(min-width: 1280px) 66vw, 100vw"
          alt="{{ section.settings.alt_text | default: img.alt | default: 'Warehouse photo' | strip_newlines }}"
          width="{{ img.width }}"
          height="{{ img.height }}"
          loading="lazy"
        >
      {%- else -%}
        <div class="home-story__placeholder">
          <span class="home-story__placeholder-label">{{ 'home_story.placeholder' | t }}</span>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home story",
  "settings": [
    {
      "type": "header",
      "content": "Copy"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Since 2000"
    },
    {
      "type": "text",
      "id": "number",
      "label": "Large number / headline",
      "default": "26 years"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body copy",
      "default": "Since 2000, we have worked across wholesale and retail in Italy, sourcing genuine stock and serving every customer with care."
    },
    {
      "type": "header",
      "content": "Photo"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Wide image"
    },
    {
      "type": "text",
      "id": "alt_text",
      "label": "Alt text override",
      "info": "Optional. Falls back to the image's own alt text if left blank."
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "0"
        },
        {
          "type": "textarea",
          "id": "label",
          "label": "Label",
          "info": "A new line controls where the label breaks.",
          "default": "supporting label"
        }
      ]
    }
  ],
  "max_blocks": 3
}
{% endschema %}
